# Copy to .env and fill in. Never commit .env, never paste the key in a chat.
# Every key the project reads is listed here; a missing key must fail loudly at startup.

# KVA key: Vercel AI Gateway (appears on the dashboard on Saturday morning)
AI_GATEWAY_API_KEY=

# OpenAI-compatible endpoint of the gateway
LLM_BASE_URL=https://ai-gateway.vercel.sh/v1

# Which endpoint llm.py uses: kva (default) | openrouter
LLM_PROVIDER=kva

# Fallback ONLY if the KVA budget runs out (HTTP 402): OpenRouter, OpenAI-compatible, paid by us.
# To switch: LLM_PROVIDER=openrouter and set both model lines below to OpenRouter model ids
# (check them on openrouter.ai/models). Only the selected provider's key must be filled in.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Models (one string each; browse vercel.com/ai-gateway/models)
# Extraction runs once per AD and is cached, so it uses the stronger model
LLM_MODEL_EXTRACTION=anthropic/claude-sonnet-5.5
# Phrasing runs on every answer, so it uses a cheaper, faster model
LLM_MODEL_PHRASING=google/gemini-3.5-flash

# Explicit timeouts, in seconds
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_TOTAL_TIMEOUT_SECONDS=30
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_TOTAL_TIMEOUT_SECONDS=20

# true = use cached extraction in data/cache/, never call the LLM on the demo path
DEMO_MODE=true
